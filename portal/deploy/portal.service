# 3x-ui 独立用户门户 —— systemd 单元示例
#
# 安装：
#   sudo cp deploy/portal.service /etc/systemd/system/portal.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now portal
#
# 约定（详见 docs/DEPLOY.md）：
#   程序目录  /opt/portal           （portal/ 目录内容，含 server.js、src/、public/）
#   环境文件  /etc/portal/portal.env（权限 600，root 拥有，内容即 portal/.env）
#   数据目录  /opt/portal/data     （PORTAL_DB_PATH 默认 ./data/portal.db）
#   运行用户  portal（系统用户，无登录 shell）

[Unit]
Description=3x-ui Independent User Portal
Documentation=file:/opt/portal/README.md
After=network-online.target
Wants=network-online.target
# 配置错误时不要无限重启刷日志
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=portal
Group=portal
WorkingDirectory=/opt/portal
# 密钥、Token、数据库路径都放在这个文件里（不要写进本单元，会被 systemd 状态/日志看到）
EnvironmentFile=/etc/portal/portal.env
Environment=NODE_ENV=production
# 注意：用 `command -v node` 确认 node 的实际路径。NodeSource / 官方二进制通常是 /usr/bin/node；
# nvm、Volta、fnm 安装在用户目录下的 node 不适用于 systemd 单元（也受 ProtectHome=yes 限制）。
ExecStart=/usr/bin/node --no-warnings server.js
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=15

# ---------------- 安全加固 ----------------
# 门户只需要：读程序目录、写自己的 SQLite 数据目录、访问 3x-ui TCP 端口。
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
# 全盘只读，仅下面 ReadWritePaths 例外；日志走 journald，不需要写文件系统
ProtectSystem=strict
ProtectHome=yes
# 唯一可写的目录：SQLite 数据库及其 -wal / -shm 文件所在目录。
# 若修改 PORTAL_DB_PATH，必须同步改这里，否则数据库无法写入（启动即报错）。
ReadWritePaths=/opt/portal/data
UMask=0077
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# systemd >= 247 支持；更老的 systemd 会忽略这两行并给出警告，不影响启动
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# 监听 8090 等非特权端口，不需要任何 capability
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
