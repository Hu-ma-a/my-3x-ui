# ===== 门户自身 =====
# 监听地址：反向代理后建议改为 127.0.0.1
PORTAL_HOST=0.0.0.0
PORTAL_PORT=8090

# SQLite 数据库路径（目录会自动创建）
PORTAL_DB_PATH=./data/portal.db
# 数据目录（默认 ./data；Docker 部署时设为 /data 以挂载数据卷）
# PORTAL_DATA_DIR=./data

# 会话 / CSRF / 签名密钥，生产环境必填，建议 >= 32 位随机字符
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 未设置时会自动生成并保存到数据目录下的 .secret 文件
PORTAL_SECRET=

# 首个管理员（数据库为空时自动创建；密码留空则首次启动随机生成并打印一次）
PORTAL_ADMIN_USERNAME=admin
PORTAL_ADMIN_PASSWORD=

# 门户对外地址，用于拼支付回调地址，例如 https://portal.example.com
# 留空则按请求的 Host / X-Forwarded-* 推断
PORTAL_PUBLIC_URL=

# 反向代理后设为 true，信任 X-Forwarded-For / X-Forwarded-Proto
PORTAL_TRUST_PROXY=false

# 日志级别：info 或 debug
PORTAL_LOG_LEVEL=info

# ===== 3x-ui 面板连接 =====
XUI_URL=http://127.0.0.1:2053
XUI_BASE_PATH=/
# 推荐：admin scope 的 API Token（面板设置里创建，或命令行生成）
XUI_API_TOKEN=
# 没有 Token 时回退用户名密码登录（不推荐，面板若开 2FA 则不可用）
XUI_USERNAME=
XUI_PASSWORD=
XUI_TIMEOUT_MS=15000

# ===== 支付方式 =====
# 可选：mock,manual,epay（逗号分隔）
PAY_PROVIDERS=mock,manual,epay
# 易支付（彩虹易支付协议）
EPAY_URL=
EPAY_PID=
EPAY_KEY=
EPAY_TYPE=alipay
# 仅测试环境：模拟支付是否在创建订单后自动完成（正式环境保持 false）
PAY_MOCK_AUTO_COMPLETE=false
